# Reference C generator metadata. Comments are internal and are not emitted.
[generator]
name = "c"
extension = "c"

[preamble]
description = "Render the C file header."
template = """/*
 * Portable C generated by STC.
 * Source: {source}
 * IEC profile: IEC 61131-3 Edition {edition}
 *
 * This file contains the translated IEC 61131-3 program and its runtime glue.
 * Regenerate it from the Structured Text source instead of editing it directly.
 */

/* Standard C library headers. */
#include <stdbool.h>
#include <stdint.h>
#include <math.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/* Checked IEC reference dereference: NULL is a runtime error. */
#define STC_DEREF(pointer) (*((pointer) != NULL ? (pointer) : (abort(), (pointer))))

"""

[global_variable]
description = "Render one mutable configuration global variable."
template = "{type} {name} = {value};\n"

[global_constant]
description = "Render one constant configuration global variable."
template = "const {type} {name} = {value};\n"

[configuration]
description = "Render one IEC configuration scheduler."
template = "/* IEC configuration {name}. */\n{declarations}\n{body}"
