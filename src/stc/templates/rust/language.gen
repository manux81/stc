[generator]
name = "rust"
adapter = "rust"
extension = "rs"

[preamble]
description = "Render the Rust module header."
template = """//! Portable Rust generated by STC.
//! Source: {source}.
//! IEC profile: IEC 61131-3 Edition {edition}.
//!
//! This module contains the translated IEC program and its runtime glue.
//! Regenerate this file from Structured Text instead of editing it directly.

#![allow(non_snake_case, non_camel_case_types, non_upper_case_globals)]
#![allow(unused_assignments, unused_mut, unused_variables, unused_unsafe, unused_parens)]

/// Dereference an IEC reference and trap the required NULL error.
#[allow(dead_code)]
unsafe fn stc_deref<'a, T>(pointer: *mut T) -> &'a mut T {
    assert!(!pointer.is_null(), "IEC NULL reference dereference");
    unsafe { &mut *pointer }
}

"""

[global_variable]
description = "Render one mutable configuration global variable."
template = "/// IEC global variable `{name}`.\n#[allow(non_upper_case_globals)]\npub static mut {name}: {type} = {value};\n"

[global_constant]
description = "Render one constant configuration global variable."
template = "/// IEC global variable `{name}`.\n#[allow(non_upper_case_globals)]\npub static mut {name}: {type} = {value};\n"

[configuration]
description = "Render one IEC configuration scheduler."
template = "/// Scheduler state for IEC configuration `{name}`.\n{declarations}\n{body}"

[scheduler_program]
template = "    pub {instance}: {type},\n"

[scheduler_task]
template = "    {name}_elapsed_ms: u64,\n"

[scheduler_program_default]
template = "        {instance}: Default::default(),\n"

[scheduler_task_default]
template = "        {name}_elapsed_ms: 0,\n"

[scheduler_reset]
template = "        self.{name}_elapsed_ms = 0;\n"

[scheduler_init]
template = "        self.{instance}.{method}();\n"

[scheduler_run]
template = "{indent}self.{instance}.run();\n"

[scheduler_single_decl]
template = "        let mut {name}_fired = false;\n"

[scheduler_due]
template = "            next_due_ms = next_due_ms.min({interval} - self.{name}_elapsed_ms);\n"

[scheduler_due_single]
template = "            if !{name}_fired { next_due_ms = next_due_ms.min({interval} - self.{name}_elapsed_ms); }\n"

[scheduler_advance]
template = "{indent}self.{name}_elapsed_ms += {delta};\n"

[scheduler_advance_single]
template = "{indent}if !{name}_fired { self.{name}_elapsed_ms += {delta}; }\n"

[scheduler_fire]
template = "            // Task {name}: interval {interval} ms, priority {priority}.\n            if self.{name}_elapsed_ms >= {interval} {\n                self.{name}_elapsed_ms -= {interval};\n{calls}            }\n"

[scheduler_fire_single]
template = "            if !{name}_fired && self.{name}_elapsed_ms >= {interval} {\n                self.{name}_elapsed_ms -= {interval};\n{calls}                self.{name}_elapsed_ms = 0;\n                {name}_fired = true;\n            }\n"

[scheduler_loop]
template = "        let mut remaining_ms = elapsed_ms;\n{singles}        while remaining_ms > 0 {\n            let mut next_due_ms = u64::MAX;\n{due}            if next_due_ms > remaining_ms {\n{remainder}                break;\n            }\n{advance}            remaining_ms -= next_due_ms;\n{fire}        }\n"

[scheduler_body]
template = "impl Default for {name} {\n    fn default() -> Self { Self {\n{defaults}    } }\n}\n\nimpl {name} {\n    pub const fn base_interval_ms() -> u64 { {base} }\n    pub fn cold_start(&mut self) { *self = Self::default(); }\n    pub fn warm_start(&mut self) {\n{warm}{reset}    }\n    pub fn cycle(&mut self, elapsed_ms: u64) {\n{free}{loop}    }\n}\n\n"

[scheduler_declarations]
template = "#[allow(non_snake_case)]\npub struct {name} {\n{programs}{tasks}}\n\n"
