# Variables: {name}
[type]
description = "Map IEC primitive types to portable C11 types."
mapping = { SINT = "int8_t", INT = "int16_t", DINT = "int32_t", LINT = "int64_t", USINT = "uint8_t", UINT = "uint16_t", UDINT = "uint32_t", ULINT = "uint64_t", REAL = "float", LREAL = "double", BOOL = "bool", BYTE = "uint8_t", WORD = "uint16_t", DWORD = "uint32_t", LWORD = "uint64_t", TIME = "int64_t", LTIME = "int64_t", DATE = "int64_t", LDATE = "int64_t", TOD = "int64_t", LTOD = "int64_t", TIME_OF_DAY = "int64_t", DT = "int64_t", LDT = "int64_t", DATE_AND_TIME = "int64_t", CHAR = "uint8_t", WCHAR = "uint16_t", UCHAR = "uint32_t", STRING = "const char *", WSTRING = "const char *", USTRING = "const char *" }

[type_alias]
template = "typedef {type} {name};\n"

[enum_type]
template = "typedef enum {name} {\n{values}} {name};\n"

[enum_value]
template = "    {name}{comma}\n"

[structure_type]
template = "typedef struct {name} {\n{fields}} {name};\n"

[structure_field]
template = "{indent}{declaration};\n"

[string_type]
template = "typedef char {name}[{size} + 1];\n"

[reference_inline]
template = "{type} *"

[declarator]
template = "{type}{separator}{name}"

[pointer_declarator]
template = "{type}{separator}*{name}"

[array_declarator]
template = "{type} {name}{dimensions}"

[array_pointer_declarator]
template = "{type} (*{name}){dimensions}"

[zero_default]
template = "0"

[zero_array]
template = "{0}"

[zero_named_array]
template = "{0}"

[zero_enum]
template = "{value}"

[zero_value]
mapping = {"bool" = "false", "float" = "0.0f", "double" = "0.0", "const char *" = "NULL"}

[section_header]
template = "/* --- {title} {padding} */\n\n"

[local_variable]
template = "{indent}{declaration} = {value};\n"

[state_field]
template = "{indent}{declaration};\n"

[enum_default_marker]
template = ""

[zero_reference]
template = "NULL"

[zero_vector]
template = "{0}"

[layout_patterns]
mapping = {"reference" = ".*\\*\\s*$", "array" = "(?P<type>[^\\[]+)(?P<dimensions>\\[.*)", "array_value" = "(?!)", "vector" = "(?!)", "attached_name" = ".*\\*\\s*$"}
